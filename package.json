{
  "name": "@boois/dsh-delete-sessions",
  "version": "0.3.3",
  "description": "给 DeepSeek Harness 增加真正的「删除会话」：从侧栏会话菜单永久删除一个会话（停活动、关唤醒闸门与定时任务、删日志文件/投影缓存/spill 临时文件/工作区记账），而不是只能归档。fork 自 dsh-delete-sessions，按 docs/AUDIT-0.2.2.md 的审计结论加固。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "screenshots.json",
    "assets"
  ],
  "scripts": {
    "test": "node --check lib/index.js && node --check lib/client.js && node tests/selfcheck.mjs",
    "test:audit": "node --check tools/audit/probe-endpoints.mjs && node --check tools/audit/tar-inspect.mjs && node --check tools/audit/asar-list.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "delete",
    "删除会话"
  ],
  "license": "MIT",
  "author": "linusteller",
  "maintainers": [
    {
      "name": "boois",
      "email": "booisming@gmail.com"
    }
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.2-rc.1 <0.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boois/dsh-session-delete.git"
  },
  "homepage": "https://github.com/boois/dsh-session-delete#readme",
  "bugs": {
    "url": "https://github.com/boois/dsh-session-delete/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
